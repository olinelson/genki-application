---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Oli Nelson → Genki · Lead Web Engineer',
  description =
    'An interactive application for the Lead Web Engineer role at Genki — built in Astro with Claude Code, by Oli Nelson.',
} = Astro.props

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const ogImage = new URL(`${base}/og.jpg`, Astro.site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/favicon.svg'}
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Oli Nelson — I built this instead of a cover letter." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="scrollbar" aria-hidden="true"></div>
    <slot />

    <script>
      // accordion (click-based, single-open, accessible).
      // Reveal-on-scroll is pure CSS now — see `.reveal` (animation-timeline: view()).
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.item-btn'))
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const isOpen = btn.getAttribute('aria-expanded') === 'true'
          buttons.forEach((b) => b.setAttribute('aria-expanded', 'false'))
          btn.setAttribute('aria-expanded', String(!isOpen))
        })
      })

      // for the engineer who opens devtools — hello 👋
      const brand = 'color:#c25a12;font:600 13px ui-monospace,monospace'
      const soft = 'color:#8a8c78;font:400 12px ui-monospace,monospace'
      console.log('%cYou opened the console. Good instinct.', brand)
      console.log(
        '%cThis page is static Astro — zero JS framework, ~5kb of vanilla script, built with Claude Code.\nIf you got this far, you should probably just email me: olivernelson@hey.com',
        soft,
      )
    </script>
  </body>
</html>
